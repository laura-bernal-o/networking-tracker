# Copy this file to .env.local and fill in real values from your Neon project.
# Never commit .env.local — it is already excluded via .gitignore.

# --- Public (safe to expose to the browser) ---
# Neon Console → your project → Auth → "Auth URL"
NEXT_PUBLIC_NEON_AUTH_URL=https://your-project.neonauth.your-region.aws.neon.tech/your-db/auth

# Neon Console → your project → Data API → "Data API URL"
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-project.apirest.your-region.aws.neon.tech/your-db/rest/v1

# --- Server-only (never sent to the browser, never commit real values) ---
# Only needed if you run db/schema.sql via `psql "$DATABASE_URL"` locally.
# Neon Console → your project → Connect
DATABASE_URL=postgresql://user:password@your-project.your-region.aws.neon.tech/your-db?sslmode=require

# Not used by this app's current implementation (auth runs entirely
# client-side against NEXT_PUBLIC_NEON_AUTH_URL), but reserved here in case
# a future server-side auth proxy is added.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
